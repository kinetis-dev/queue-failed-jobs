{
    "name": "kinetis/queue-failed-jobs",
    "description": "Retained failed jobs for kinetis/queue — every job the worker gives up on is recorded in a MySQL/Postgres table before the backend deletes it, with commands to list, retry, forget and prune the records.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "^1.27.0",
        "kinetis/queue": "^1.10.0",
        "kinetis/persistence": "^1.4.6",
        "kinetis/database-bridge": "^1.4.4",
        "psr/container": "^2.0.2"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "kinetis/migrations": "^1.5.0",
        "kinetis/queue-sql": "^1.6.10",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.3",
        "vimeo/psalm": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\QueueFailedJobs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\QueueFailedJobs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {
            "scan": "Kinetis\\QueueFailedJobs\\Console\\",
            "bootstrap": "Kinetis\\QueueFailedJobs\\PackageBootstrap"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
